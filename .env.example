# =============================================================================
# Doce Fefê.21 — Modelo de variáveis de ambiente
# =============================================================================
#
# COMO USAR
#   1. Copie este arquivo para `.env`   (Windows:  copy .env.example .env)
#   2. Preencha os valores reais obtidos nos painéis do Supabase e Mercado Pago
#   3. NUNCA versione o arquivo `.env` — ele já está no .gitignore
#
# REGRA DE OURO DE SEGURANÇA
#   Somente variáveis que começam com VITE_ são embutidas no JavaScript que vai
#   para o navegador. Todas as demais ficam exclusivamente no servidor.
#   Portanto: um segredo SEM o prefixo VITE_ é estruturalmente impossível de
#   vazar para o cliente.
# =============================================================================


# -----------------------------------------------------------------------------
# [PÚBLICO — vai para o navegador] Frontend
# -----------------------------------------------------------------------------

# Endereço da API do backend.
# Em desenvolvimento deixe vazio: o proxy do Vite redireciona /api -> :3000
VITE_API_URL=

# Supabase — Painel > Project Settings > API
# A "anon key" é pública POR DESIGN. Ela é segura porque todo o acesso é
# filtrado pelas políticas RLS (Row Level Security) do banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics (opcional). Formato: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=


# -----------------------------------------------------------------------------
# [SECRETO — somente servidor] Backend
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Domínios autorizados a chamar a API (separados por vírgula)
CORS_ORIGINS=http://localhost:5173

# Supabase — chave de serviço.
# ATENÇÃO: esta chave IGNORA todas as políticas RLS e tem poder total sobre o
# banco. Ela existe só para o backend. Se vazar, o banco inteiro está exposto.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo usado para assinar/validar sessões administrativas
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Mercado Pago  (Painel do desenvolvedor > Suas integrações > Credenciais)
# -----------------------------------------------------------------------------
# Use as credenciais de TESTE enquanto estiver desenvolvendo.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Chave secreta do webhook (Painel > Webhooks > Configurar notificações).
# Serve para provar que a notificação veio mesmo do Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública que o Mercado Pago chamará para notificar pagamentos.
# Em desenvolvimento, use um túnel (ex.: ngrok) — localhost não é acessível
# pela internet.
MERCADOPAGO_WEBHOOK_URL=

# URL base do site, usada para montar os retornos do checkout
SITE_URL=http://localhost:5173
